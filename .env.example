# ──────────────────────────────────────────────────────────────
#  TempMail configuration — copy to `.env` and adjust.
# ──────────────────────────────────────────────────────────────

# Domain(s) that receive mail, comma-separated. Each needs an MX record
# pointing at this server. The first one is used for new addresses.
DOMAINS=example.com

# Name shown in the header, page title and SMTP banner.
SITE_NAME=TempMail

# ── Web ───────────────────────────────────────────────────────
# Port of the Next.js server (put it behind a reverse proxy for HTTPS).
PORT=3000

# ── SMTP ──────────────────────────────────────────────────────
SMTP_ENABLED=true
SMTP_HOST=0.0.0.0
# Internal port. Map public port 25 to it (Docker does this for you).
SMTP_PORT=2525
# Hostname announced in the SMTP greeting (defaults to the first domain).
# SMTP_HOSTNAME=mail.example.com
# Optional TLS certificate for STARTTLS (a self-signed one is used otherwise).
# SMTP_TLS_KEY=/certs/privkey.pem
# SMTP_TLS_CERT=/certs/fullchain.pem

# ── Limits ────────────────────────────────────────────────────
MESSAGE_TTL_MINUTES=60
MAX_MESSAGES_PER_INBOX=50
MAX_TOTAL_MESSAGES=5000
MAX_MESSAGE_SIZE_MB=10
MAX_SSE_CONNECTIONS=1000
