{
  "name": "temp-mail",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted disposable email service built with Next.js — built-in SMTP server, real-time inbox and a clean web UI.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.9"
  },
  "keywords": [
    "temp-mail",
    "disposable-email",
    "temporary-email",
    "smtp",
    "nextjs",
    "self-hosted",
    "privacy"
  ],
  "author": "KarolFli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarolFli/temp-Mail.git"
  },
  "bugs": {
    "url": "https://github.com/KarolFli/temp-Mail/issues"
  },
  "homepage": "https://github.com/KarolFli/temp-Mail#readme",
  "dependencies": {
    "mailparser": "^3.14.5",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "^3.21.6"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "nodemailer": "^10.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
